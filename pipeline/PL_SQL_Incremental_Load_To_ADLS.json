				"defaultValue": "0"
			},
			"watermarkColumn": {
				"type": "string",
				"defaultValue": "0"
			},
			"targetContainer": {
				"type": "string",
				"defaultValue": "0"
			},
			"targetFolderPath": {
				"type": "string",
				"defaultValue": "0"
			},
			"targetFileName": {
